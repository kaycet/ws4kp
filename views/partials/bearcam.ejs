<%- include('header.ejs', {title:'Bear Cam', hasTime: true}) %>
<div class="main has-scroll bearcam">
  <style>
    /* scoped here so the cam needs no scss pipeline change. has-scroll gives the
       standard layout — 90px top banner, 310px panel, blue scroll banner below —
       so the scrolling conditions text sits on the banner, not on the video. */
    .weather-display .main.bearcam {
      position: relative;
      overflow: hidden;
      /* the classic gradient shows through as thin rails either side of the
         video (frame starts 90px below the display top — offset to line up) */
      background: url(../images/backgrounds/1.png) no-repeat 0 -90px;
    }
    .weather-display .main.bearcam .bearcam-frame {
      /* COVER-crop between the rails: 20px of gradient each side, player sized
         to fill 600x310 (fill width, crop ~15px top+bottom). */
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 339px;
      border: 0;
      display: block;
      background: #000;
    }
    /* Widescreen: stock wide mode keeps a 640px panel offset by the 107px
       margin — the cam takes the full 854px canvas with 24px gradient rails. */
    .wide .weather-display .main.bearcam {
      left: 0;
      width: 854px;
      background-image: url(../images/backgrounds/1-wide.png);
    }
    /* 806x310 between the rails -> fill width at 806x454, crop 72px top+bottom */
    .wide .weather-display .main.bearcam .bearcam-frame {
      width: 806px;
      height: 454px;
    }
    .weather-display .main.bearcam .bearcam-caption {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 2px 12px;
      font-family: 'Star4000';
      font-size: 24pt;
      color: #fff;
      text-shadow: 3px 3px 0 #000;
      pointer-events: none;
    }
  </style>
  <!-- src attached by bearcam.mjs only while this display is shown.
       referrerpolicy must send at least the origin: YouTube refuses embeds with
       no referer (Error 153 "video player configuration error"). -->
  <iframe class="bearcam-frame" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; fullscreen" allowfullscreen></iframe>
  <div class="bearcam-caption">Live &middot; Brooks Falls, Katmai N.P.</div>
</div>
