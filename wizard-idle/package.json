{
	"name": "starfall-spire",
	"version": "0.2.0",
	"private": true,
	"description": "A pixel-art wizard idle game with spells, wisps, prestige, and weekly Rift Trials.",
	"type": "module",
	"scripts": {
		"start": "node scripts/serve.mjs",
		"test": "node --test test/*.test.mjs",
		"lint": "eslint js scripts test *.mjs",
		"build": "node scripts/build.mjs",
		"check": "npm run lint && npm test && npm run build"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"eslint": "^9.0.0",
		"eslint-config-airbnb-base": "15.0.0",
		"eslint-plugin-import": "^2.31.0"
	}
}
